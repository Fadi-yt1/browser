# Copy to .env and adjust. Every value has a working default.

# --- public surface -------------------------------------------------------
PUBLIC_PORT=8080
BIND_ADDR=0.0.0.0
# Sign session tokens with a stable secret so restarts do not kill live sessions.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# --- capacity -------------------------------------------------------------
# Unlimited mode: no time cap on a session, several sessions per visitor.
# Concurrency is still capped, because each session is a real browser.
UNLIMITED_MODE=true
# Rule of thumb: one session per CPU core, ~1.2 GB RAM each. 4 suits a 4 GB box.
MAX_CONCURRENT_SESSIONS=4
MAX_SESSIONS_PER_CLIENT=3
# 0 = no time limit. Set e.g. 1200000 (20 min) on a public instance.
SESSION_TTL_MS=0
# Kill a session this long after its tab stops answering.
IDLE_TIMEOUT_MS=90000
MAX_QUEUE_LENGTH=200

# --- per-session resources ------------------------------------------------
SESSION_MEMORY_MB=1024
SESSION_CPUS=1
SESSION_SHM_MB=512
SCREEN_WIDTH=1280
SCREEN_HEIGHT=800
DEFAULT_START_URL=https://duckduckgo.com

# --- abuse control --------------------------------------------------------
LAUNCH_RATE_LIMIT=10
LAUNCH_RATE_WINDOW_MS=60000
CONTROL_RATE_LIMIT=240

LOG_LEVEL=info
