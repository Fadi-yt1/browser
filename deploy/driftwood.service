# Runs the gateway with the local (Docker-free) runtime.
#   sudo cp deploy/driftwood.service /etc/systemd/system/
#   sudo systemctl enable --now driftwood
[Unit]
Description=Driftwood browser-in-browser gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=driftwood
Group=driftwood
WorkingDirectory=/opt/driftwood
EnvironmentFile=-/opt/driftwood/.env
Environment=NODE_ENV=production
Environment=SESSION_RUNTIME=local
Environment=STATIC_DIR=/opt/driftwood/web/dist
ExecStart=/usr/bin/node /opt/driftwood/server/dist/index.js
Restart=always
RestartSec=3

# The gateway itself needs none of these; sessions run as the same user.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
